Bootstrap: docker
From: ubuntu:26.04
%post
  export DEBIAN_FRONTEND=noninteractive
  sed -i "s/^Types: deb$/Types: deb deb-src/" /etc/apt/sources.list.d/ubuntu.sources
  apt-get update
  apt-get install -y build-essential cmake ninja-build git pkg-config ccache
  apt-get build-dep -y kicad
  apt-get install -y libprotobuf-dev protobuf-compiler libnng-dev libgit2-dev libsecret-1-dev libzstd-dev libpoppler-glib-dev libboost-test-dev libcurl4-openssl-dev libspnav-dev libgtk-3-dev libglm-dev libngspice0-dev libocct-data-exchange-dev libocct-draw-dev libharfbuzz-dev libfontconfig-dev libodbc2 unixodbc-dev libwxgtk3.2-dev libwxgtk-webview3.2-dev swig python3-dev python3-wxgtk4.0 || true
  apt-get clean
